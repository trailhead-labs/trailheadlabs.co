{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trailhead-labs/trailheadlabs.co",
    "type": "project",
    "description": "The Trailhead Labs site, exported to static HTML.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "spatie/laravel-export": "^1.5"
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "format": [
            "vendor/bin/pint --blade"
        ],
        "build": [
            "@composer run format",
            "npm run build",
            "rm -f public/hot",
            "APP_ENV=production APP_URL=https://trailheadlabs.co php artisan export"
        ],
        "publish": [
            "composer test",
            "@composer run build",
            "npx gh-pages --dist=dist --cname=trailheadlabs.co --message=publish --nojekyll"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
